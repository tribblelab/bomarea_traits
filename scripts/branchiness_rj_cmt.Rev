anc_states = readAncestralStateTrace("output/branchiness_mrates_rj_ard_states_combined.txt")
anc_tree = ancestralStateTree(tree=phylogeny, ancestral_state_trace_vector=anc_states, include_start_states=false, file="output/branchiness_2rate_rj_ase_ard.tree", burnin=0, summary_statistic="MAP", site=1)