morpho <- readDiscreteCharacterData("data/branchiness.nexus")

phylogeny <- readTrees("data/tree_edited.tre")[1]

moves = VectorMoves()
monitors = VectorMonitors()

# define dimensions of our rate matrix 
NUM_STATES = 8

# specify our transition rate parameters to fill in our matrix 

# up rate is drawn from an exponential
q_up ~ dnExponential(2)
moves.append( mvScale(q_up, lambda=0.2) )

# down rate is drawn from a reversible jump, sampling
# between being equal to the up rate or drawn from 
# its own exponential
mix_prob <- 0.5
q_down ~ dnReversibleJumpMixture(q_up, dnExponential(2), mix_prob)
moves.append( mvRJSwitch(q_down, weight=2.0) )
moves.append( mvScale(q_down,   lambda=0.2) )

# track the probability that the up/down rates are the same
up_down_same := ifelse(q_down == q_up, 1.0, 0.0 )


# within compound rate is drawn from an exponential
q_within_compound ~ dnExponential(2)
moves.append( mvScale(q_within_compound, lambda=0.2) )

# change type rate (from umbel to compound) is drawn from 
# a reversible jump, sampling between being equal to within
# compound or drawn from its own exponential
q_change_type ~ dnReversibleJumpMixture(q_within_compound, dnExponential(2), mix_prob)
moves.append( mvRJSwitch(q_change_type, weight=2.0) )
moves.append( mvScale(q_change_type,   lambda=0.2) )

within_between_same := ifelse(q_within_compound == q_change_type, 1.0, 0.0 )


#### create an empty Q-matrix
for (i in 1:NUM_STATES) {
for (j in 1:NUM_STATES) {
q[i][j] := 0.0
}
}


q[1][2] :=q_up + q_change_type

q[2][1] :=q_down + q_change_type
q[2][3] :=q_up + q_within_compound

q[3][2] :=q_down + q_within_compound
q[3][4] :=q_up + q_within_compound

q[4][3] :=q_down + q_within_compound
q[4][5] :=q_up + q_within_compound

q[5][4] :=q_down + q_within_compound
q[5][6] :=q_up + q_within_compound

q[6][5] :=q_down + q_within_compound
q[6][7] :=q_up + q_within_compound

q[7][6] :=q_down + q_within_compound
q[7][8] :=q_up + q_within_compound

q[8][7] :=q_down + q_within_compound

Q := fnFreeK(q, rescale=FALSE)


# root states
# let's not do this
# rf_prior <- rep(1,NUM_STATES)
# rf ~ dnDirichlet( rf_prior )
# moves.append( mvBetaSimplex( rf, weight=2 ) )
# moves.append( mvDirichletSimplex( rf, weight=2 ) )

# phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q, rootFrequencies=rf, type="Standard")
phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q, type="Standard")
phyMorpho.clamp(morpho)
mymodel = model(phylogeny)
monitors.append( mnModel(filename="output/branchiness_rj_cmt_norf.log", printgen=10) )
monitors.append( mnScreen(printgen=100) )
# monitors.append( mnJointConditionalAncestralState(tree=phylogeny,
#                                                    ctmc=phyMorpho,
#                                                    filename="output/branchiness_2rates_rj_ard_states.txt",
#                                                    type="Standard",
#                                                    printgen=1,
#                                                    withTips=true,
#                                                    withStartStates=false) )

mymcmc = mcmc(mymodel, monitors, moves, nruns=2)
mymcmc.burnin(generations=5000,tuningInterval=50)
mymcmc.run(generations=50000)
