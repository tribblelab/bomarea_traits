################################################################################
#
# RevBayes Example: Testing for correlation between characters.
#
# authors:  Sebastian Höhna
#
################################################################################

#######################
# Reading in the Data #
#######################

CHARACTER_A = "elevation"
CHARACTER_B = "type"
NUM_STATES_A = 12
NUM_STATES_B = 2

# Import the morphological character matrix #
morpho_A <- readDiscreteCharacterData("data/elevation.nexus")
morpho_B <- readDiscreteCharacterData("data/binary_type_corr.nexus")

morpho = combineCharacter( morpho_A, morpho_B )

# Create some vector for the moves and monitors of this analysis
moves    = VectorMoves()
monitors = VectorMonitors()

##############
# Tree model #
##############

# Here we use a fixed tree topology of primates
# Note that the readTrees function always returns a vector of trees,
# so we simple take the first tree
phylogeny <- readTrees("data/tree_edited.tre")[1]


#########################
# Set up the rate model #
#########################

# we assume every rate i <-> j to be independent and exponentially distributed
rate_pr := phylogeny.treeLength() / 10
for (i in 1:24) {
    for (j in 1:24) {
        q[i][j] <- 0.0
    }
}

mix_prob <- 0.5

rate_increase_when_0 ~ dnExponential(rate_pr)
rate_decrease_when_0 ~ dnExponential(rate_pr)

rate_increase_when_1 ~ dnReversibleJumpMixture(rate_increase_when_0, dnExponential(rate_pr), mix_prob)
rate_decrease_when_1 ~ dnReversibleJumpMixture(rate_decrease_when_0, dnExponential(rate_pr), mix_prob)

# rate_0_to_1 ~ dnExponential(rate_pr)

rate_0_to_1_when_A ~ dnExponential( rate_pr )
rate_0_to_1_when_AB ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_ABC ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_B ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_BC ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_BCD ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_C ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_CD ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_CDE ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_D ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_DE ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_0_to_1_when_E ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)

# rate_1_to_0 ~ dnExponential(rate_pr)

rate_1_to_0_when_A ~ dnExponential( rate_pr )
rate_1_to_0_when_AB ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_ABC ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_B ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_BC ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_BCD ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_C ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_CD ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_CDE ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_D ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_DE ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)
rate_1_to_0_when_E ~ dnReversibleJumpMixture(rate_0_to_1_when_A, dnExponential( rate_pr ), mix_prob)

moves.append(mvScale(rate_increase_when_0, weight = 4))
moves.append(mvScale(rate_decrease_when_0, weight = 4))
moves.append(mvRJSwitch(rate_increase_when_1, weight = 4))
moves.append(mvRJSwitch(rate_decrease_when_1, weight = 4))

moves.append(mvScale(rate_0_to_1_when_A, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_AB, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_ABC, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_B, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_BC, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_BCD, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_C, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_CD, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_CDE, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_D, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_DE, weight = 2))
moves.append(mvRJSwitch(rate_0_to_1_when_E, weight = 2))

moves.append(mvScale(rate_1_to_0_when_A, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_AB, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_ABC, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_B, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_BC, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_BCD, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_C, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_CD, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_CDE, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_D, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_DE, weight = 2))
moves.append(mvRJSwitch(rate_1_to_0_when_E, weight = 2))

# prob_increase_indep := ifelse(rate_increase_when_1 == rate_increase_when_0, 1.0, 0.0 )
# prob_decrease_indep := ifelse(rate_decrease_when_1 == rate_decrease_when_0, 1.0, 0.0)
# prob_0_to_1_A_indep :=
# prob_0_to_1_AB_indep :=
# prob_0_to_1_ABC_indep :=
# prob_0_to_1_B_indep :=
# prob_0_to_1_BC_indep :=
# prob_0_to_1_BCD_indep :=
# prob_0_to_1_C_indep :=
# prob_0_to_1_CD_indep :=
# prob_0_to_1_C_indep :=
# 
# prob_1_to_0_A_indep :=
# prob_1_to_0_AB_indep :=
# prob_1_to_0_ABC_indep :=
# prob_1_to_0_B_indep :=
# prob_1_to_0_BC_indep :=
# prob_1_to_0_BCD_indep :=
# prob_1_to_0_C_indep :=
# prob_1_to_0_CD_indep :=
# prob_1_to_0_C_indep :=


##### new rates 

q[1][2] := rate_increase_when_0
q[1][13] := rate_0_to_1_when_A

q[2][1] := rate_decrease_when_0
q[2][3] := rate_increase_when_0
q[2][14] := rate_0_to_1_when_AB

q[3][2] := rate_decrease_when_0
q[3][4] := rate_increase_when_0
q[3][15] := rate_0_to_1_when_ABC

q[4][3] := rate_decrease_when_0
q[4][5] := rate_increase_when_0
q[4][16] := rate_0_to_1_when_B

q[5][4] := rate_decrease_when_0
q[5][6] := rate_increase_when_0
q[5][17] := rate_0_to_1_when_BC

q[6][5] := rate_decrease_when_0
q[6][7] := rate_increase_when_0
q[6][18] := rate_0_to_1_when_BCD

q[7][6] := rate_decrease_when_0
q[7][8] := rate_increase_when_0
q[7][19] := rate_0_to_1_when_C

q[8][7] := rate_decrease_when_0
q[8][9] := rate_increase_when_0
q[8][20] := rate_0_to_1_when_CD
 
q[9][8] := rate_decrease_when_0
q[9][10] := rate_increase_when_0
q[9][21] := rate_0_to_1_when_CDE

q[10][9] := rate_decrease_when_0
q[10][11] := rate_increase_when_0
q[10][22] := rate_0_to_1_when_D

q[11][10] := rate_decrease_when_0
q[11][12] := rate_increase_when_0
q[11][23] := rate_0_to_1_when_DE

q[12][11] := rate_decrease_when_0
q[12][24] := rate_0_to_1_when_E

q[13][1] := rate_1_to_0_when_A
q[13][12] := rate_decrease_when_1

q[14][2] := rate_1_to_0_when_AB
q[14][13] := rate_decrease_when_1
q[14][14] := rate_increase_when_1

q[15][3] := rate_1_to_0_when_ABC
q[15][14] := rate_decrease_when_1
q[15][16] := rate_increase_when_1

q[16][4] := rate_1_to_0_when_B
q[16][15] := rate_decrease_when_1
q[16][17] := rate_increase_when_1

q[17][5] := rate_1_to_0_when_BC
q[17][16] := rate_decrease_when_1
q[17][18] := rate_increase_when_1

q[18][6] := rate_1_to_0_when_BCD
q[18][17] := rate_decrease_when_1
q[18][19] := rate_increase_when_1

q[19][7] := rate_1_to_0_when_C
q[19][18] := rate_decrease_when_1
q[19][20] := rate_increase_when_1

q[20][8] := rate_1_to_0_when_CD
q[20][19] := rate_decrease_when_1
q[20][21] := rate_increase_when_1

q[21][9] := rate_1_to_0_when_CDE
q[21][20] := rate_decrease_when_1
q[21][22] := rate_increase_when_1

q[22][10] := rate_1_to_0_when_D
q[22][21] := rate_decrease_when_1
q[22][23] := rate_increase_when_1

q[23][11] := rate_1_to_0_when_DE
q[23][22] := rate_decrease_when_1
q[23][24] := rate_increase_when_1

q[24][12] := rate_1_to_0_when_E
q[24][23] := rate_decrease_when_1

Q := fnFreeK(q, rescaled=FALSE)

#####################################
# Set up the root state frequencies #
#####################################

rf_prior <- rep(1,NUM_STATES_A*NUM_STATES_B)
rf ~ dnDirichlet( rf_prior )
moves.append( mvBetaSimplex( rf, weight=2 ) )
moves.append( mvDirichletSimplex( rf, weight=2 ) )



###################
# Set up the CTMC #
###################

# Combine all of our elements into a CTMC.
phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q, rootFrequencies=rf, type="NaturalNumbers")
phyMorpho.clamp( morpho )


########
# MCMC #
########

# initialize the model object #
mymodel = model(phylogeny)
monitors.append( mnModel(filename="output/elevation_range_type_corr_RJ.log", printgen=100) ) 
monitors.append( mnScreen(printgen=100) )
# monitors.append( mnJointConditionalAncestralState(tree=phylogeny,
#                                                  ctmc=phyMorpho,
#                                                  filename="output/elevation_type_corr_RJ.states.txt",
#                                                  type="NaturalNumbers",
#                                                  printgen=1,
#                                                  withTips=true,
#                                                  withStartStates=false) )
# monitors.append( mnStochasticCharacterMap(ctmc=phyMorpho,
#                                          filename="output/elevation_type_corr_RJ_stoch_char_map.log",
#                                          printgen=1000,
#                                          include_simmap=true) )


# Initialize the MCMC object #
mymcmc = mcmc(mymodel, monitors, moves, nruns=2, combine="sequential")

# Run the MCMC #
mymcmc.burnin(2000, tuningInterval = 50)
mymcmc.run(generations=200000)


# Read in the tree trace and construct the ancestral states (ASE) #
# anc_states = readAncestralStateTrace("output/elevation_type_corr_RJ.states.txt")
# anc_tree = ancestralStateTree(tree=phylogeny,
#                              ancestral_state_trace_vector=anc_states,
#                              include_start_states=false, file="output/elevation_type_ase_corr_RJ.tree",
#                              burnin=0.25,
#                              summary_statistic="MAP",
#                              site=1,
#                              nStates=NUM_STATES_A*NUM_STATES_B)



# read in the sampled character histories
# anc_states_stoch_map = readAncestralStateTrace("output/elevation_type_corr_RJ_stoch_char_map.log")

# summarizeCharacterMaps(anc_states_stoch_map, phylogeny, file="output/elevation_type_corr_RJ.events.tsv", burnin=0.25)


# make summary tree
# char_map_tree = characterMapTree(tree=phylogeny,
#                 ancestral_state_trace_vector=anc_states_stoch_map,
#                 character_file="output/elevation_type_corr_RJ_marginal_character.tree",
#                 posterior_file="output/elevation_type_corr_RJ_marginal_posterior.tree",
#                 burnin=0.25,
#                 num_time_slices=500)

# Quit RevBayes #
q()
