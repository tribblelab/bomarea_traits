################################################################################
#
# RevBayes Example: Testing for correlation between characters.
#
# authors:  Sebastian Höhna
#
################################################################################

#######################
# Reading in the Data #
#######################

CHARACTER_A = "elevation"
CHARACTER_B = "type"
NUM_STATES_A = 4
NUM_STATES_B = 2

# Import the morphological character matrix #
morpho_A <- readDiscreteCharacterData("data/elevation.nexus")
morpho_B <- readDiscreteCharacterData("data/binary_type.nexus")

morpho = combineCharacter( morpho_A, morpho_B )

# Create some vector for the moves and monitors of this analysis
moves    = VectorMoves()
monitors = VectorMonitors()

##############
# Tree model #
##############

# Here we use a fixed tree topology of primates
# Note that the readTrees function always returns a vector of trees,
# so we simple take the first tree
phylogeny <- readTrees("data/tree_edited.tre")[1]


#########################
# Set up the rate model #
#########################

# we assume every rate i <-> j to be independent and exponentially distributed
rate_pr := phylogeny.treeLength() / 10
for (i in 1:14) {
    for (j in 1:14) {
        q[i][j] <- 0.0
    }
}

mix_prob <- 0.5

rate_increase_when_0 ~ dnExponential(rate_pr)
rate_decrease_when_0 ~ dnExponential(rate_pr)

rate_increase_when_1 ~ dnReversibleJumpMixture(rate_increase_when_0, dnExponential(rate_pr), mix_prob)
rate_decrease_when_1 ~ dnReversibleJumpMixture(rate_decrease_when_0, dnExponential(rate_pr), mix_prob)

rate_0_to_1 ~ dnExponential(rate_pr)
rate_1_to_0 ~ dnExponential(rate_pr)

moves.append(mvScale(rate_increase_when_0, weight = 2))
moves.append(mvScale(rate_decrease_when_0, weight = 2))
moves.append(mvScale(rate_0_to_1, weight = 2))
moves.append(mvScale(rate_1_to_0, weight = 2))

moves.append(mvRJSwitch(rate_increase_when_1, weight = 2))
moves.append(mvRJSwitch(rate_decrease_when_1, weight = 2))

prob_increase_indep := ifelse(rate_increase_when_1 == rate_increase_when_0, 1.0, 0.0 )
prob_decrease_indep := ifelse(rate_decrease_when_1 == rate_decrease_when_0, 1.0, 0.0)

##### new rates 

q[1][2] := rate_increase_when_0
q[1][8] := rate_0_to_1

q[2][1] := rate_decrease_when_0
q[2][3] := rate_increase_when_0
q[2][9] := rate_0_to_1

q[3][2] := rate_decrease_when_0
q[3][4] := rate_increase_when_0
q[3][10] := rate_0_to_1

q[4][3] := rate_decrease_when_0
q[4][5] := rate_increase_when_0
q[4][11] := rate_0_to_1

q[5][4] := rate_decrease_when_0
q[5][6] := rate_increase_when_0
q[5][12] := rate_0_to_1

q[6][5] := rate_decrease_when_0
q[6][7] := rate_increase_when_0
q[6][13] := rate_0_to_1

q[7][6] := rate_decrease_when_0
q[7][14] := rate_0_to_1

q[8][1] := rate_1_to_0
q[8][9] := rate_increase_when_1

q[9][2] := rate_1_to_0
q[9][8] := rate_decrease_when_1
q[9][10] := rate_increase_when_1

q[10][3] := rate_1_to_0
q[10][9] := rate_decrease_when_1
q[10][11] := rate_increase_when_1

q[11][4] := rate_1_to_0
q[11][10] := rate_decrease_when_1
q[11][12] := rate_increase_when_1

q[12][5] := rate_1_to_0
q[12][11] := rate_decrease_when_1
q[12][13] := rate_increase_when_1

q[13][6] := rate_1_to_0
q[13][12] := rate_decrease_when_1
q[13][14] := rate_increase_when_1

q[14][7] := rate_1_to_0
q[14][13] := rate_decrease_when_1

Q := fnFreeK(q, rescaled=FALSE)

#####################################
# Set up the root state frequencies #
#####################################

rf_prior <- rep(1,NUM_STATES_A*NUM_STATES_B)
rf ~ dnDirichlet( rf_prior )
moves.append( mvBetaSimplex( rf, weight=2 ) )
moves.append( mvDirichletSimplex( rf, weight=2 ) )



###################
# Set up the CTMC #
###################

# Combine all of our elements into a CTMC.
phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q, rootFrequencies=rf, type="NaturalNumbers")
phyMorpho.clamp( morpho )


########
# MCMC #
########

# initialize the model object #
mymodel = model(phylogeny)
monitors.append( mnModel(filename="output/elevation_type_corr_RJ.log", printgen=100) )
monitors.append( mnScreen(printgen=100) )
# monitors.append( mnJointConditionalAncestralState(tree=phylogeny,
#                                                  ctmc=phyMorpho,
#                                                  filename="output/elevation_type_corr_RJ.states.txt",
#                                                  type="NaturalNumbers",
#                                                  printgen=1,
#                                                  withTips=true,
#                                                  withStartStates=false) )
# monitors.append( mnStochasticCharacterMap(ctmc=phyMorpho,
#                                          filename="output/elevation_type_corr_RJ_stoch_char_map.log",
#                                          printgen=1000,
#                                          include_simmap=true) )


# Initialize the MCMC object #
mymcmc = mcmc(mymodel, monitors, moves, nruns=2, combine="sequential")

# Run the MCMC #
mymcmc.burnin(1000, tuningInterval = 50)
mymcmc.run(generations=2000000)


# Read in the tree trace and construct the ancestral states (ASE) #
# anc_states = readAncestralStateTrace("output/elevation_type_corr_RJ.states.txt")
# anc_tree = ancestralStateTree(tree=phylogeny,
#                              ancestral_state_trace_vector=anc_states,
#                              include_start_states=false, file="output/elevation_type_ase_corr_RJ.tree",
#                              burnin=0.25,
#                              summary_statistic="MAP",
#                              site=1,
#                              nStates=NUM_STATES_A*NUM_STATES_B)



# read in the sampled character histories
# anc_states_stoch_map = readAncestralStateTrace("output/elevation_type_corr_RJ_stoch_char_map.log")

# summarizeCharacterMaps(anc_states_stoch_map, phylogeny, file="output/elevation_type_corr_RJ.events.tsv", burnin=0.25)


# make summary tree
# char_map_tree = characterMapTree(tree=phylogeny,
#                 ancestral_state_trace_vector=anc_states_stoch_map,
#                 character_file="output/elevation_type_corr_RJ_marginal_character.tree",
#                 posterior_file="output/elevation_type_corr_RJ_marginal_posterior.tree",
#                 burnin=0.25,
#                 num_time_slices=500)

# Quit RevBayes #
q()
