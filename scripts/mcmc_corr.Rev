################################################################################
#
# RevBayes Example: Testing for correlation between characters.
#
# authors:  Sebastian Höhna
#
################################################################################

#######################
# Reading in the Data #
#######################

CHARACTER_A = "elevation"
CHARACTER_B = "type"
NUM_STATES_A = 4
NUM_STATES_B = 2

# Import the morphological character matrix #
morpho_A <- readDiscreteCharacterData("data/elevation.nexus")
morpho_B <- readDiscreteCharacterData("data/binary_type.nexus")

morpho = combineCharacter( morpho_A, morpho_B )

# Create some vector for the moves and monitors of this analysis
moves    = VectorMoves()
monitors = VectorMonitors()

##############
# Tree model #
##############

# Here we use a fixed tree topology of primates
# Note that the readTrees function always returns a vector of trees,
# so we simple take the first tree
phylogeny <- readTrees("data/tree_edited.tre")[1]


#########################
# Set up the rate model #
#########################

# we assume every rate i <-> j to be independent and exponentially distributed
rate_pr := phylogeny.treeLength() / 10
for (i in 1:8) {
    for (j in 1:8) {
        q[i][j] <- 0.0
    }
}

mix_prob <- 0.5

rate_A0_A1_when_B0 ~ dnExponential( rate_pr )
rate_A1_A2_when_B0 ~ dnExponential( rate_pr )
rate_A2_A3_when_B0 ~ dnExponential( rate_pr )

rate_A0_A1_when_B1 ~ dnReversibleJumpMixture(rate_A0_A1_when_B0, dnExponential( rate_pr ), mix_prob)
rate_A1_A2_when_B1 ~ dnReversibleJumpMixture(rate_A1_A2_when_B0, dnExponential( rate_pr ), mix_prob)
rate_A2_A3_when_B1 ~ dnReversibleJumpMixture(rate_A2_A3_when_B0, dnExponential( rate_pr ), mix_prob)

rate_A3_A2_when_B0 ~ dnExponential( rate_pr )
rate_A2_A1_when_B0 ~ dnExponential( rate_pr )
rate_A1_A0_when_B0 ~ dnExponential( rate_pr )

rate_A3_A2_when_B1 ~ dnReversibleJumpMixture(rate_A3_A2_when_B0, dnExponential( rate_pr ), mix_prob)
rate_A2_A1_when_B1 ~ dnReversibleJumpMixture(rate_A2_A1_when_B0, dnExponential( rate_pr ), mix_prob)
rate_A1_A0_when_B1 ~ dnReversibleJumpMixture(rate_A1_A0_when_B0, dnExponential( rate_pr ), mix_prob)

rate_B0_B1_when_A0 ~ dnExponential( rate_pr )
rate_B0_B1_when_A1 ~ dnReversibleJumpMixture(rate_B0_B1_when_A0, dnExponential( rate_pr ), mix_prob)
rate_B0_B1_when_A2 ~ dnReversibleJumpMixture(rate_B0_B1_when_A0, dnExponential( rate_pr ), mix_prob)
rate_B0_B1_when_A3 ~ dnReversibleJumpMixture(rate_B0_B1_when_A0, dnExponential( rate_pr ), mix_prob)

rate_B1_B0_when_A0 ~ dnExponential( rate_pr )
rate_B1_B0_when_A1 ~ dnReversibleJumpMixture(rate_B1_B0_when_A0, dnExponential( rate_pr ), mix_prob)
rate_B1_B0_when_A2 ~ dnReversibleJumpMixture(rate_B1_B0_when_A0, dnExponential( rate_pr ), mix_prob)
rate_B1_B0_when_A3 ~ dnReversibleJumpMixture(rate_B1_B0_when_A0, dnExponential( rate_pr ), mix_prob)

moves.append( mvScale(rate_A0_A1_when_B0, weight=2 ) )
moves.append( mvScale(rate_A1_A2_when_B0, weight=2 ) )
moves.append( mvScale(rate_A2_A3_when_B0, weight=2 ) )

moves.append( mvRJSwitch(rate_A0_A1_when_B1, weight=2 ) )
moves.append( mvRJSwitch(rate_A1_A2_when_B1, weight=2 ) )
moves.append( mvRJSwitch(rate_A2_A3_when_B1, weight=2 ) )

moves.append( mvScale(rate_A3_A2_when_B0, weight=2 ) )
moves.append( mvScale(rate_A2_A1_when_B0, weight=2 ) )
moves.append( mvScale(rate_A1_A0_when_B0, weight=2 ) )

moves.append( mvRJSwitch(rate_A3_A2_when_B1, weight=2 ) )
moves.append( mvRJSwitch(rate_A2_A1_when_B1, weight=2 ) )
moves.append( mvRJSwitch(rate_A1_A0_when_B1, weight=2 ) )

moves.append( mvScale(rate_B0_B1_when_A0, weight=2 ) )
moves.append( mvRJSwitch(rate_B0_B1_when_A1, weight=2 ) )
moves.append( mvRJSwitch(rate_B0_B1_when_A2, weight=2 ) )
moves.append( mvRJSwitch(rate_B0_B1_when_A3, weight=2 ) )

moves.append( mvScale(rate_B1_B0_when_A0, weight=2 ) )
moves.append( mvRJSwitch(rate_B1_B0_when_A1, weight=2 ) )
moves.append( mvRJSwitch(rate_B1_B0_when_A2, weight=2 ) )
moves.append( mvRJSwitch(rate_B1_B0_when_A3, weight=2 ) )

prob_gain_A_indep := ifelse( rate_gain_A_when_B0 == rate_gain_A_when_B1, 1.0, 0.0 )
prob_loss_A_indep := ifelse( rate_loss_A_when_B0 == rate_loss_A_when_B1, 1.0, 0.0 )
prob_gain_B_indep := ifelse( rate_gain_B_when_A0 == rate_gain_B_when_A1, 1.0, 0.0 )
prob_loss_B_indep := ifelse( rate_loss_B_when_A0 == rate_loss_B_when_A1, 1.0, 0.0 )


##### update the part below with new rates 

q[1][2] := rate_A0_A1_when_B1 # 00->10
q[1][5] := rate_B0_B1_when_A0 # 00->01

q[2][1] := rate_A1_A0_when_B0 # 10->00
q[2][3] := rate_A1_A2_when_B0 # 10->20
q[2][6] := rate_B0_B1_when_A1 # 10->11

q[3][2] := rate_A1_A2_when_B0 # 20->10
q[3][4] := rate_A2_A3_when_B0 # 20->30
q[3][7] := rate_B0_B1_when_A2 # 20->21

q[4][3] := rate_A3_A2_when_B0 # 30->20
q[4][8] := rate_B0_B1_when_A3 # 30->31

q[5][1] := rate_B1_B0_when_A0 # 01->00
q[5][6] := rate_A0_A1_when_B1 # 01->11

q[6][2] := rate_B1_B0_when_A1 # 11->10
q[6][5] := rate_A1_A0_when_B1 # 21->01
q[6][7] := rate_A1_A2_when_B1 # 11->21

q[7][3] := rate_B1_B0_when_A2 # 21->20
q[7][6] := rate_A2_A1_when_B1 # 21->11
q[7][8] := rate_A2_A3_when_B1 # 21->31

q[8][4] := rate_B1_B0_when_A3 # 31->30
q[8][7] := rate_A3_A2_when_B1 # 31->21

Q := fnFreeK(q, rescaled=FALSE)

#####################################
# Set up the root state frequencies #
#####################################

rf_prior <- rep(1,NUM_STATES_A*NUM_STATES_B)
rf ~ dnDirichlet( rf_prior )
moves.append( mvBetaSimplex( rf, weight=2 ) )
moves.append( mvDirichletSimplex( rf, weight=2 ) )



###################
# Set up the CTMC #
###################

# Combine all of our elements into a CTMC.
phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q, rootFrequencies=rf, type="NaturalNumbers")
phyMorpho.clamp( morpho )


########
# MCMC #
########

# initialize the model object #
mymodel = model(phylogeny)
monitors.append( mnModel(filename="output/elevation_type_corr_RJ.log", printgen=100) )
monitors.append( mnScreen(printgen=100) )
# monitors.append( mnJointConditionalAncestralState(tree=phylogeny,
#                                                  ctmc=phyMorpho,
#                                                  filename="output/elevation_type_corr_RJ.states.txt",
#                                                  type="NaturalNumbers",
#                                                  printgen=1,
#                                                  withTips=true,
#                                                  withStartStates=false) )
# monitors.append( mnStochasticCharacterMap(ctmc=phyMorpho,
#                                          filename="output/elevation_type_corr_RJ_stoch_char_map.log",
#                                          printgen=1000,
#                                          include_simmap=true) )


# Initialize the MCMC object #
mymcmc = mcmc(mymodel, monitors, moves, nruns=2, combine="sequential")

# Run the MCMC #
mymcmc.burnin(1000, tuningInterval = 50)
mymcmc.run(generations=2000000)


# Read in the tree trace and construct the ancestral states (ASE) #
#anc_states = readAncestralStateTrace("output/elevation_type_corr_RJ.states.txt")
#anc_tree = ancestralStateTree(tree=phylogeny,
#                              ancestral_state_trace_vector=anc_states,
#                              include_start_states=false, file="output/elevation_type_ase_corr_RJ.tree",
#                              burnin=0.25,
#                              summary_statistic="MAP",
#                              site=1,
#                              nStates=NUM_STATES_A*NUM_STATES_B)



# read in the sampled character histories
#anc_states_stoch_map = readAncestralStateTrace("output/elevation_type_corr_RJ_stoch_char_map.log")

#summarizeCharacterMaps(anc_states_stoch_map, phylogeny, file="output/elevation_type_corr_RJ.events.tsv", burnin=0.25)


# make summary tree
#char_map_tree = characterMapTree(tree=phylogeny,
#                 ancestral_state_trace_vector=anc_states_stoch_map,
#                 character_file="output/elevation_type_corr_RJ_marginal_character.tree",
#                 posterior_file="output/elevation_type_corr_RJ_marginal_posterior.tree",
#                 burnin=0.25,
#                 num_time_slices=500)

# Quit RevBayes #
q()
