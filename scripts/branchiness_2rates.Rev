morpho <- readDiscreteCharacterData("data/branchiness.nexus")

phylogeny <- readTrees("data/tree_edited.tre")[1]

moves = VectorMoves()
monitors = VectorMonitors()

# define dimensions of our rate matrix 
NUM_STATES = 8

# specify our transition rate parameters to fill in our matrix 
q_up ~ dnExponential(2)
moves.append(mvScale(q_up, lambda = 0.2))
q_down ~ dnExponential(2)
moves.append(mvScale(q_down, lambda = 0.2))

#### Create an empty Q-matrix
for (i in 1:NUM_STATES) {
for (j in 1:NUM_STATES) {
q[i][j] := 0.0
}
}


q[1][2] :=q_up

q[2][1] :=q_down
q[2][3] :=q_up

q[3][2] :=q_down
q[3][4] :=q_up

q[4][3] :=q_down
q[4][5] :=q_up

q[5][4] :=q_down
q[5][6] :=q_up

q[6][5] :=q_down
q[6][7] :=q_up

q[7][6] :=q_down
q[7][8] :=q_up

q[8][7] :=q_down

Q := fnFreeK(q, rescale=FALSE)


# root states
rf_prior <- rep(1,NUM_STATES)
rf ~ dnDirichlet( rf_prior )
moves.append( mvBetaSimplex( rf, weight=2 ) )
moves.append( mvDirichletSimplex( rf, weight=2 ) )

phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q, rootFrequencies=rf, type="Standard")
phyMorpho.clamp(morpho)
mymodel = model(phylogeny)
monitors.append( mnModel(filename="output/branchiness_ard.log", printgen=10) )
monitors.append( mnScreen(printgen=100) )
monitors.append( mnJointConditionalAncestralState(tree=phylogeny,
                                                   ctmc=phyMorpho,
                                                   filename="output/branchiness_ard_states.txt",
                                                   type="Standard",
                                                   printgen=1,
                                                   withTips=true,
                                                   withStartStates=false) )

mymcmc = mcmc(mymodel, monitors, moves, nruns=2)
mymcmc.burnin(generations=500,tuningInterval=100)
mymcmc.run(generations=25000, tuningInterval=200)
->
anc_states = readAncestralStateTrace("output/branchiness_ard_states_combined.txt")
anc_tree = ancestralStateTree(tree=phylogeny, ancestral_state_trace_vector=anc_states, include_start_states=false, file="output/branchiness_ase_ard.tree", burnin=0, summary_statistic="MAP", site=1)