################################################################################
#
# RevBayes Example: Testing for correlation between characters.
#
# authors:  Sebastian Höhna
#
################################################################################

#######################
# Reading in the Data #
#######################

CHARACTER_A = "elevation"
CHARACTER_B = "type"
NUM_STATES_A = 12
NUM_STATES_B = 2

# Import the morphological character matrix #
morpho_A <- readDiscreteCharacterData("data/elevation.nexus")
morpho_B <- readDiscreteCharacterData("data/type_corr.nexus")

morpho = combineCharacter( morpho_A, morpho_B )

# Create some vector for the moves and monitors of this analysis
moves    = VectorMoves()
monitors = VectorMonitors()

##############
# Tree model #
##############

# Here we use a fixed tree topology of primates
# Note that the readTrees function always returns a vector of trees,
# so we simple take the first tree
phylogeny <- readTrees("data/tree_edited_corr.tre")[1]


#########################
# Set up the rate model #
#########################

# we assume every rate i <-> j to be independent and exponentially distributed
rate_pr := phylogeny.treeLength() / 10
for (i in 1:24) {
    for (j in 1:24) {
        q[i][j] <- 0.0
    }
}

mix_prob <- 0.5

#### no rj, increase/decrease elevation
# rate_increase_l_to_m ~ dnExponential(rate_pr)
# rate_increase_same ~ dnExponential(rate_pr)
# rate_increase_m_to_h ~ dnExponential(rate_pr)
# rate_increase_h_to_m ~ dnExponential(rate_pr)
# 
# rate_decrease_h_to_m ~ dnExponential(rate_pr)
# rate_decrease_same ~ dnExponential(rate_pr)
# rate_decrease_m_to_l ~ dnExponential(rate_pr)
# rate_decrease_m_to_h ~ dnExponential(rate_pr)
# 
# rate_0_to_1 ~ dnExponential(rate_pr)
# rate_1_to_0 ~ dnExponential(rate_pr)


### rj for compound
 rate_increase_when_0 ~ dnExponential(rate_pr)
 rate_decrease_when_0 ~ dnExponential(rate_pr)
 
 rate_increase_when_1 ~ dnReversibleJumpMixture(rate_increase_when_0, dnExponential(rate_pr), mix_prob)
 rate_decrease_when_1 ~ dnReversibleJumpMixture(rate_decrease_when_0, dnExponential(rate_pr), mix_prob)
 
 rate_0_to_1 ~ dnExponential(rate_pr)
 
 rate_1_to_0 ~ dnExponential(rate_pr)
 
 moves.append(mvScale(rate_increase_when_0, weight = 2))
 moves.append(mvScale(rate_decrease_when_0, weight = 2))
 moves.append(mvRJSwitch(rate_increase_when_1, weight = 2))
 moves.append(mvRJSwitch(rate_decrease_when_1, weight = 2))
 
 moves.append(mvScale(rate_0_to_1, weight = 2))
 moves.append(mvScale(rate_1_to_0, weight = 2))
 
 prob_increase_indep := ifelse(rate_increase_when_1 == rate_increase_when_0, 1.0, 0.0 )
 prob_decrease_indep := ifelse(rate_decrease_when_1 == rate_decrease_when_0, 1.0, 0.0)### rates without rj for compound/simple


 q[1][2] := rate_increase_when_0
 q[1][13] := rate_0_to_1
 
 q[2][1] := rate_decrease_when_0
 q[2][3] := rate_increase_when_0
 q[2][14] := rate_0_to_1
 
 q[3][2] := rate_decrease_when_0
 q[3][4] := rate_increase_when_0
 q[3][15] := rate_0_to_1
 
 q[4][3] := rate_decrease_when_0
 q[4][5] := rate_increase_when_0
 q[4][16] := rate_0_to_1
 
 q[5][4] := rate_decrease_when_0
 q[5][6] := rate_increase_when_0
 q[5][17] := rate_0_to_1
 
 q[6][5] := rate_decrease_when_0
 q[6][7] := rate_increase_when_0
 q[6][18] := rate_0_to_1
 
 q[7][6] := rate_decrease_when_0
 q[7][8] := rate_increase_when_0
 q[7][19] := rate_0_to_1
 
 q[8][7] := rate_decrease_when_0
 q[8][9] := rate_increase_when_0
 q[8][20] := rate_0_to_1
  
 q[9][8] := rate_decrease_when_0
 q[9][10] := rate_increase_when_0
 q[9][21] := rate_0_to_1
 
 q[10][9] := rate_decrease_when_0
 q[10][11] := rate_increase_when_0
 q[10][22] := rate_0_to_1
 
 q[11][10] := rate_decrease_when_0
 q[11][12] := rate_increase_when_0
 q[11][23] := rate_0_to_1
 
 q[12][11] := rate_decrease_when_0
 q[12][24] := rate_0_to_1
 
 q[13][1] := rate_1_to_0
 q[13][14] := rate_increase_when_1
 
 q[14][2] := rate_1_to_0
 q[14][13] := rate_decrease_when_1
 q[14][14] := rate_increase_when_1
 
 q[15][3] := rate_1_to_0
 q[15][14] := rate_decrease_when_1
 q[15][16] := rate_increase_when_1
 
 q[16][4] := rate_1_to_0
 q[16][15] := rate_decrease_when_1
 q[16][17] := rate_increase_when_1
 
 q[17][5] := rate_1_to_0
 q[17][16] := rate_decrease_when_1
 q[17][18] := rate_increase_when_1
 
 q[18][6] := rate_1_to_0
 q[18][17] := rate_decrease_when_1
 q[18][19] := rate_increase_when_1
 
 q[19][7] := rate_1_to_0
 q[19][18] := rate_decrease_when_1
 q[19][20] := rate_increase_when_1
 
 q[20][8] := rate_1_to_0
 q[20][19] := rate_decrease_when_1
 q[20][21] := rate_increase_when_1
 
 q[21][9] := rate_1_to_0
 q[21][20] := rate_decrease_when_1
 q[21][22] := rate_increase_when_1
 
 q[22][10] := rate_1_to_0
 q[22][21] := rate_decrease_when_1
 q[22][23] := rate_increase_when_1
 
 q[23][11] := rate_1_to_0
 q[23][22] := rate_decrease_when_1
 q[23][24] := rate_increase_when_1
 
 q[24][12] := rate_1_to_0
 q[24][23] := rate_decrease_when_1

Q := fnFreeK(q, rescaled=FALSE)

#####################################
# Set up the root state frequencies #
#####################################

# rf_prior <- rep(1,NUM_STATES_A*NUM_STATES_B)
# rf ~ dnDirichlet( rf_prior )
# moves.append( mvBetaSimplex( rf, weight=2 ) )
# moves.append( mvDirichletSimplex( rf, weight=2 ) )



###################
# Set up the CTMC #
###################

# Combine all of our elements into a CTMC.
phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q, type="NaturalNumbers")
phyMorpho.clamp( morpho )


########
# MCMC #
########

# initialize the model object #
mymodel = model(phylogeny)
monitors.append( mnModel(filename="output/corr/elevation_type_corr_RJ.log", printgen=100) ) 
monitors.append( mnScreen(printgen=100) )
monitors.append( mnJointConditionalAncestralState(tree=phylogeny,
                                                 ctmc=phyMorpho,
                                                 filename="output/corr/elevation_type_corr_RJ.states.txt",
                                                 type="NaturalNumbers",
                                                 printgen=1,
                                                 withTips=true,
                                                 withStartStates=false) )
monitors.append( mnStochasticCharacterMap(ctmc=phyMorpho,
                                         filename="output/corr/elevation_type_corr_RJ_stoch_char_map.log",
                                         printgen=1000,
                                         include_simmap=true) )


# Initialize the MCMC object #
mymcmc = mcmc(mymodel, monitors, moves, nruns=2, combine="sequential")

# Run the MCMC #
mymcmc.burnin(4000, tuningInterval = 50)
mymcmc.run(generations=80000)

# Read in the tree trace and construct the ancestral states (ASE) #
anc_states = readAncestralStateTrace("output/corr/elevation_type_corr_RJ.states.txt")
anc_tree = ancestralStateTree(tree=phylogeny,
                             ancestral_state_trace_vector=anc_states,
                             include_start_states=false, file="output/corr/elevation_type_ase_corr_RJ.tree",
                             burnin=0.25,
                             summary_statistic="MAP",
                             site=1,
                             nStates=NUM_STATES_A*NUM_STATES_B)


# read in the sampled character histories
anc_states_stoch_map = readAncestralStateTrace("output/corr/elevation_type_corr_RJ_stoch_char_map.log")
summarizeCharacterMaps(anc_states_stoch_map, phylogeny, file="output/corr/elevation_type_corr_RJ.events.tsv", burnin=0.25)


# make summary tree
char_map_tree = characterMapTree(tree=phylogeny,
                ancestral_state_trace_vector=anc_states_stoch_map,
                character_file="output/corr/elevation_type_corr_RJ_marginal_character.tree",
                posterior_file="output/corr/elevation_type_corr_RJ_marginal_posterior.tree",
                burnin=0.25,
                num_time_slices=500)

# Quit RevBayes #
q()
