morpho <- readDiscreteCharacterData("data/branchiness.nexus")

phylogeny <- readTrees("data/tree_edited.tre")[1]

moves = VectorMoves()
monitors = VectorMonitors()

# define dimensions of our rate matrix 
NUM_STATES = 8

# specify our transition rate parameters to fill in our matrix 

# up rate is drawn from an exponential
q_up ~ dnExponential(2)
moves.append( mvScale(q_up, lambda=0.2) )

# down rate is drawn from a reversible jump, sampling
# between being equal to the up rate or drawn from 
# its own exponential
mix_prob <- 0.5
q_down ~ dnReversibleJumpMixture(q_up, dnExponential(2), mix_prob)
moves.append( mvRJSwitch(q_down, weight=2.0) )
moves.append( mvScale(q_down,   lambda=0.2) )

# track the probability that the up/down rates are the same
up_down_same := ifelse(q_down == q_up, 1.0, 0.0 )


# base rate for change
q_change_1 ~ dnExponential(2)
moves.append( mvScale(q_change_1, lambda=0.2) )

# test to see if other changes are different from base 
q_change_2 ~ dnReversibleJumpMixture(q_change_1, dnExponential(2), mix_prob)
moves.append( mvRJSwitch(q_change_2, weight=2.0) )
moves.append( mvScale(q_change_2,   lambda=0.2) )
two_same := ifelse(q_change_2 == q_change_1, 1.0, 0.0 )

q_change_3 ~ dnReversibleJumpMixture(q_change_1, dnExponential(2), mix_prob)
moves.append( mvRJSwitch(q_change_3, weight=2.0) )
moves.append( mvScale(q_change_3,   lambda=0.2) )
three_same := ifelse(q_change_3 == q_change_1, 1.0, 0.0 )

q_change_4 ~ dnReversibleJumpMixture(q_change_1, dnExponential(2), mix_prob)
moves.append( mvRJSwitch(q_change_4, weight=2.0) )
moves.append( mvScale(q_change_4,   lambda=0.2) )
four_same := ifelse(q_change_4 == q_change_1, 1.0, 0.0 )

q_change_5 ~ dnReversibleJumpMixture(q_change_1, dnExponential(2), mix_prob)
moves.append( mvRJSwitch(q_change_5, weight=2.0) )
moves.append( mvScale(q_change_5,   lambda=0.2) )
five_same := ifelse(q_change_5 == q_change_1, 1.0, 0.0 )

q_change_6 ~ dnReversibleJumpMixture(q_change_1, dnExponential(2), mix_prob)
moves.append( mvRJSwitch(q_change_6, weight=2.0) )
moves.append( mvScale(q_change_6,   lambda=0.2) )
six_same := ifelse(q_change_6 == q_change_1, 1.0, 0.0 )

q_change_7 ~ dnReversibleJumpMixture(q_change_1, dnExponential(2), mix_prob)
moves.append( mvRJSwitch(q_change_7, weight=2.0) )
moves.append( mvScale(q_change_7,   lambda=0.2) )
seven_same := ifelse(q_change_7 == q_change_1, 1.0, 0.0 )

#### Create an empty Q-matrix
for (i in 1:NUM_STATES) {
for (j in 1:NUM_STATES) {
q[i][j] := 0.0
}
}


q[1][2] :=q_up + q_change_1
q[2][1] :=q_down + q_change_1

q[2][3] :=q_up + q_change_2
q[3][2] :=q_down + q_change_2

q[3][4] :=q_up + q_change_3
q[4][3] :=q_down + q_change_3

q[4][5] :=q_up + q_change_4
q[5][4] :=q_down + q_change_4

q[5][6] :=q_up + q_change_5
q[6][5] :=q_down + q_change_5

q[6][7] :=q_up + q_change_6
q[7][6] :=q_down + q_change_6

q[7][8] :=q_up + q_change_7
q[8][7] :=q_down + q_change_7

Q := fnFreeK(q, rescale=FALSE)

# phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q, rootFrequencies=rf, type="Standard")
phyMorpho ~ dnPhyloCTMC(tree=phylogeny, Q=Q, type="Standard")
phyMorpho.clamp(morpho)
mymodel = model(phylogeny)
monitors.append( mnModel(filename="output/branchiness_rj_full_cmt_norf.log", printgen=10) )
monitors.append( mnScreen(printgen=100) )
# monitors.append( mnJointConditionalAncestralState(tree=phylogeny,
#                                                    ctmc=phyMorpho,
#                                                    filename="output/branchiness_rj_full_cmt_ard_states.txt",
#                                                    type="Standard",
#                                                    printgen=1,
#                                                    withTips=true,
#                                                    withStartStates=false) )

mymcmc = mcmc(mymodel, monitors, moves, nruns=2)
mymcmc.burnin(generations=5000,tuningInterval=50)
mymcmc.run(generations=50000)
->
anc_states = readAncestralStateTrace("output/branch/branchiness_rj_full_cmt_ard_states_combined.txt")
anc_tree = ancestralStateTree(tree=phylogeny, ancestral_state_trace_vector=anc_states, include_start_states=false, file="output/branch/branchiness_rj_full_cmt_ase_ard.tree", burnin=0, summary_statistic="MAP", site=1)